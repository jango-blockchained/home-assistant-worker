{
  "name": "home-assistant-worker",
  "account_id": "profile",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "HA_SECURE_URL": null,
    "HA_TOKEN": null,
    "INTERNAL_KEY_BINDING": null
  },
  "kv_namespaces": [
    {
      "binding": "CONFIG_KV",
      "id": "c5917667a21745e390ff969f32b1847d"
    }
  ],
  "secrets_store": {
    "bindings": [
      {
        "binding": "HA_TOKEN_BINDING",
        "store_id": "48433bc559a943f09d9d6c622e188fd5",
        "secret_name": "HA_TOKEN"
      },
      {
        "binding": "HA_SECURE_URL_BINDING",
        "store_id": "48433bc559a943f09d9d6c622e188fd5",
        "secret_name": "HA_SECURE_URL"
      }
    ]
  }
}